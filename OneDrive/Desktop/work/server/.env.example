# Server
PORT=5000
NODE_ENV=development

# Database
# Copy to .env and replace with your own values. Never commit real credentials.
# Atlas: create an M0 free-tier cluster and a database user scoped to the
# "shopsphere" database only (least privilege: readWrite on that database).
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopsphere?retryWrites=true&w=majority

# Auth
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Client
CLIENT_URL=http://localhost:5173
