# Development defaults. Copy to .env and replace JWT_SECRET.
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/shopsphere
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Production requires MONGODB_URI, CLIENT_URL, and a unique JWT_SECRET
# with at least 32 characters. Set NODE_ENV=production.
